task.spawn(function()
    local start = os.clock()
    local messages = {
        "กำลังเริ่มต้นระบบ...",
        "กำลังโหลดทรัพยากร...",
        "กำลังเตรียมอินเทอร์เฟซ...",
        "กำลังปรับแต่งเอฟเฟกต์...",
        "พร้อมแล้ว!"
    }

    while loading.Parent do
        local progress = math.clamp(
            (os.clock() - start) / LOAD_TIME,
            0,
            1
        )

        percent.Text = math.floor(progress * 100) .. "%"
        fill.Size = UDim2.new(progress, 0, 1, 0)

        local index = math.clamp(
            math.floor(progress * (#messages - 1)) + 1,
            1,
            #messages
        )
        status.Text = messages[index]

        if progress >= 1 then break end
        RunService.RenderStepped:Wait()
    end

    percent.Text = "100%"
    status.Text = "พร้อมแล้ว!"

    makeTween(welcome, 0.6, {TextTransparency = 0})
    task.wait(0.8)

    starsActive = false

    for _, star in ipairs(stars) do
        if star.Parent then
            makeTween(star, 0.5, {BackgroundTransparency = 1})
        end
    end

    local camera = workspace.CurrentCamera
    local height = camera and camera.ViewportSize.Y or 1000

    makeTween(loading, 0.9, {
        Position = UDim2.new(0, 0, 0, height * 1.6)
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    makeTween(welcome, 0.4, {TextTransparency = 1})

    task.wait(1)
    if loading.Parent then
        loading:Destroy()
    end
end)

